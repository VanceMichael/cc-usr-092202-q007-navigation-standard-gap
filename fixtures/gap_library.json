      "standard": "IALA G1151",
      "title": "风险等级与剩余风险术语",
      "source_text": "The authority shall use residual risk levels consistently in notification and escalation.",
      "official_translation": {
        "current_version": "V2",
        "versions": [
          {
            "version": "V1",
            "date": "2022-06-01",
            "text": "主管机关应在通报与升级中统一使用风险等级术语。",
            "errata": "初版官方译文，无勘误"
          },
          {
            "version": "V2",
            "date": "2026-03-01",
            "text": "主管机关应在通报与升级中统一使用剩余风险等级术语。",
            "errata": "勘误：将“风险等级”明确为“剩余风险等级”，避免与初始风险混用"
          }
        ]
      },
      "national_rule_ids": []
    },
    {
      "clause_id": "IALA-G1151-4.1",
      "standard": "IALA G1151",
      "title": "告警分级与抑制",
      "source_text": "Alerts shall be graded before suppression; misreport rate shall be monitored.",
      "official_translation": {
        "current_version": "V1",
        "versions": [
          {
            "version": "V1",
            "date": "2022-06-01",
            "text": "告警抑制前应先分级，并监测误报率。",
            "errata": "初版官方译文，无勘误"
          }
        ]
      },
      "national_rule_ids": [
        "CN-海标-2024-07"
      ]
    },
    {
      "clause_id": "IALA-G1151-5.3",
      "standard": "IALA G1151",
      "title": "导助航应急恢复时限",
      "source_text": "Temporary aids shall be deployed and navigational warnings issued within four hours.",
      "official_translation": {
        "current_version": "V2",
        "versions": [
          {
            "version": "V2",
