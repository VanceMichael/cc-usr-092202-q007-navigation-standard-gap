  "facts": [
    "培训由交通运输部海事局与国际航标组织联合主办",
    "项目新增风险管理专项培训",
    "历史学员来自四十多个国家和地区",
    "联合项目办公室维护国际条款与各成员机构实施情况的逐项对应差距库",
    "证书数量不作为标准落地的判定依据，差距以条款级证据与复核结论为准"
  ],
  "constraints": [
    "国际条款映射：条款原文、官方译文与勘误、本国规范逐项对应",
    "译文勘误只追加不回溯，已冻结旧版培训资料不改写",
    "国家规则更新只关闭确已解决的差距",
    "现场豁免必须有批准人与到期日，到期失效且不得用于关闭差距",
    "成员机构自评后须由异国民用航标主管机构同行复核",
    "证据可持续补充，含敏感设施信息的证据按国家隔离",
    "改进行动延期须记录批准人、理由与更晚的新期限",
    "需演练验证的改进未通过实际演练前不得关闭差距",
    "管理者按条款查看仍影响服务一致性的差距"
  ],
