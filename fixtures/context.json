      "title": "航标站备用电源续航",
      "text_summary": "关键航标站备用电源在主供水中断后应至少维持72小时连续工作。",
      "consistency_aspect": "equipment_capability",
      "status": "current"
    },
    {
      "id": "C-5200",
      "standard": "IALA-R-0101（虚构编号）",
      "number": "5.2.0",
      "title": "灯浮漂移处置流程",
      "text_summary": "发现灯浮漂移后应在4小时内完成现场核实并上报，按统一流程发布临时警告并组织复位。",
      "consistency_aspect": "response_process",
      "status": "current"
    },
    {
      "id": "C-5310",
      "standard": "IALA-R-0101（虚构编号）",
      "number": "5.3.10",
      "title": "能见度不良应急联动",
      "text_summary": "能见度低于阈值时，航标、VTS与搜救值班单位应按联动流程在规定时限内互换信息。",
      "consistency_aspect": "response_process",
      "status": "current"
    }
  ],
