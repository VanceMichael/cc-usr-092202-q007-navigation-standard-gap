{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/gap-library.schema.json",
  "title": "航标标准落地差距库",
  "type": "object",
  "required": ["domain", "version", "organizations", "clauses", "gaps",
               "courses", "risk_scenarios", "rule_updates", "drills"],
  "additionalProperties": false,
  "properties": {
    "domain": { "const": "navigation-standard-gap" },
    "version": { "type": "integer", "minimum": 2 },
    "organizations": {
      "type": "array",
      "items": { "$ref": "#/$defs/organization" }
    },
    "clauses": {
      "type": "array",
      "items": { "$ref": "#/$defs/clause" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    },
    "courses": {
      "type": "array",
      "items": { "$ref": "#/$defs/course" }
    },
    "risk_scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk_scenario" }
    },
    "rule_updates": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule_update" }
    },
    "drills": {
      "type": "array",
      "items": { "$ref": "#/$defs/drill" }
    }
  },
  "$defs": {
    "iso_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "organization": {
      "type": "object",
      "required": ["org_id", "name", "country_code"],
      "additionalProperties": false,
      "properties": {
        "org_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "country_code": { "type": "string", "minLength": 2 }
      }
    },
    "translation_version": {
      "type": "object",
      "required": ["version", "date", "text", "errata"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/iso_date" },
        "text": { "type": "string" },
        "errata": { "type": "string", "description": "勘误说明；初版为无勘误，绝不改写旧版本" }
      }
    },
    "clause": {
      "type": "object",
      "required": ["clause_id", "standard", "title", "source_text",
                   "official_translation", "national_rule_ids"],
      "additionalProperties": false,
      "properties": {
        "clause_id": { "type": "string", "minLength": 1 },
        "standard": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "source_text": { "type": "string" },
        "official_translation": {
          "type": "object",
          "required": ["current_version", "versions"],
          "additionalProperties": false,
          "properties": {
            "current_version": { "type": "string" },
            "versions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/translation_version" }
            }
          }
        },
        "national_rule_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "history_entry": {
      "type": "object",
      "required": ["date", "actor", "action", "detail"],
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "#/$defs/iso_date" },
        "actor": { "type": "string" },
        "action": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["type", "ref", "summary", "added_by", "date"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["document", "photo", "log", "certificate", "drill_report"]
        },
        "ref": { "type": "string" },
        "summary": { "type": "string" },
        "added_by": { "type": "string" },
        "date": { "$ref": "#/$defs/iso_date" }
      }
    },
    "peer_review": {
      "type": "object",
      "required": ["reviewer_org", "date", "verdict", "comments"],
      "additionalProperties": false,
      "properties": {
        "reviewer_org": { "type": "string" },
        "date": { "$ref": "#/$defs/iso_date" },
        "verdict": { "type": "string", "enum": ["agree", "disagree", "escalate"] },
        "comments": { "type": "string" }
      }
    },
    "self_assessment": {
      "type": "object",
      "required": ["org_id", "date", "capability_level",
                   "standard_requirement", "conformance"],
      "additionalProperties": false,
      "properties": {
        "org_id": { "type": "string" },
        "date": { "$ref": "#/$defs/iso_date" },
        "capability_level": { "type": "string" },
        "standard_requirement": { "type": "string" },
        "conformance": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "required": ["description", "owner_org", "due_date", "extensions"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "owner_org": { "type": "string" },
        "due_date": { "$ref": "#/$defs/iso_date" },
        "completed_date": { "$ref": "#/$defs/iso_date" },
        "resolution_summary": { "type": "string" },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["new_due_date", "reason", "approver", "date"],
            "additionalProperties": false,
            "properties": {
              "new_due_date": { "$ref": "#/$defs/iso_date" },
              "reason": { "type": "string", "minLength": 1 },
              "approver": { "type": "string", "minLength": 1 },
              "date": { "$ref": "#/$defs/iso_date" }
            }
          }
        }
      }
    },
    "exemption": {
      "type": "object",
      "required": ["approver", "granted_on", "expiry", "scope",
                   "sequence", "status"],
      "additionalProperties": false,
      "properties": {
        "approver": { "type": "string", "minLength": 1, "description": "豁免批准人" },
        "granted_on": { "$ref": "#/$defs/iso_date" },
        "expiry": { "$ref": "#/$defs/iso_date", "description": "豁免到期日，必填" },
        "scope": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["active", "revoked"] }
      }
    },
    "training_material": {
      "type": "object",
      "required": ["material_content_immutable"],
      "additionalProperties": true,
      "properties": {
        "material_content_immutable": {
          "const": true,
          "description": "旧版培训资料不可改写"
        },
        "course_id": { "type": "string" },
        "edition": { "type": "string" },
        "translation_version": { "type": "string" },
        "retrain_required": { "type": "boolean" }
      }
    },
    "gap": {
      "type": "object",
      "required": ["gap_id", "clause_id", "reporter_org", "country_code",
                   "category", "title", "description", "service_impact",
                   "sensitive", "status", "evidence", "peer_reviews", "history"],
      "additionalProperties": true,
      "properties": {
        "gap_id": { "type": "string", "minLength": 1 },
        "clause_id": { "type": "string" },
        "reporter_org": { "type": "string" },
        "country_code": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["terminology", "equipment", "process",
                   "training_material", "rule"]
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "service_impact": { "type": "string" },
        "sensitive": { "type": "boolean" },
        "facility": {
          "type": "object",
          "description": "敏感设施信息，按国家隔离存储"
        },
        "status": {
          "type": "string",
          "enum": ["open", "self_assessed", "peer_reviewed", "action_planned",
                   "in_progress", "action_complete", "verified", "closed",
                   "reopened"]
        },
        "term_diff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "current": { "type": "string" },
            "standard": { "type": "string" }
          }
        },
        "equipment_limit": { "type": "object" },
        "current_process": { "type": "string" },
        "training_material": { "$ref": "#/$defs/training_material" },
        "national_rule_id": { "type": "string" },
        "self_assessment": { "$ref": "#/$defs/self_assessment" },
        "peer_reviews": {
          "type": "array",
          "items": { "$ref": "#/$defs/peer_review" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "action": { "$ref": "#/$defs/action" },
        "exemption": { "$ref": "#/$defs/exemption" },
        "drill_id": { "type": "string" },
        "closed": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "by": { "type": "string" },
            "date": { "$ref": "#/$defs/iso_date" },
            "rule_update": { "type": "string" }
          }
        },
        "history": {
          "type": "array",
          "items": { "$ref": "#/$defs/history_entry" }
        }
      }
    },
    "course": {
      "type": "object",
      "required": ["course_id", "title", "edition", "material_immutable",
                   "adopting_orgs", "clause_refs"],
      "additionalProperties": false,
      "properties": {
        "course_id": { "type": "string" },
        "title": { "type": "string" },
        "edition": { "type": "string" },
        "material_immutable": { "const": true },
        "adopting_orgs": { "type": "array", "items": { "type": "string" } },
        "clause_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["clause_id", "translation_version"],
            "additionalProperties": false,
            "properties": {
              "clause_id": { "type": "string" },
              "translation_version": { "type": "string" }
            }
          }
        }
      }
    },
    "risk_scenario": {
      "type": "object",
      "required": ["scenario_id", "title", "clause_id", "hazard",
                   "standard_terms", "required_capability",
                   "expected_process", "required_equipment"],
      "additionalProperties": false,
      "properties": {
        "scenario_id": { "type": "string" },
        "title": { "type": "string" },
        "clause_id": { "type": "string" },
        "hazard": { "type": "string" },
        "standard_terms": { "type": "array", "items": { "type": "string" } },
        "required_capability": { "type": "string" },
        "expected_process": { "type": "array", "items": { "type": "string" } },
        "required_equipment": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rule_update": {
      "type": "object",
      "required": ["update_id", "national_rule_id", "country_code",
                   "effective_date", "closed_gaps", "remaining_gaps"],
      "additionalProperties": false,
      "properties": {
        "update_id": { "type": "string" },
        "national_rule_id": { "type": "string" },
        "country_code": { "type": "string" },
        "effective_date": { "$ref": "#/$defs/iso_date" },
        "closed_gaps": { "type": "array", "items": { "type": "string" } },
        "remaining_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gap_id", "reason"],
            "additionalProperties": false,
            "properties": {
              "gap_id": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "drill": {
      "type": "object",
      "required": ["drill_id", "org_id", "date", "scope", "result",
                   "evidence_ref"],
      "additionalProperties": false,
      "properties": {
        "drill_id": { "type": "string" },
        "org_id": { "type": "string" },
        "date": { "$ref": "#/$defs/iso_date" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "result": { "type": "string", "enum": ["pass", "fail"] },
        "evidence_ref": { "type": "string" },
        "scenario_ref": { "type": "string" }
      }
    }
  }
}
